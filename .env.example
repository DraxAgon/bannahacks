# Server-side only. Never expose to the browser.
GEMINI_API_KEY=
# Optional model overrides (defaults in lib/ai/models.ts)
IMAGE_MODEL=gemini-nano-banana-2.1
TEXT_MODEL=gemini-3.8-flash
CRITIC_MODEL=gemini-3.8-flash
CRITIC_FALLBACK_MODEL=gemini-3.5-flash-lite
# Spend guard (best-effort, in-memory)
MAX_LIVE_LADDERS_PER_DAY=30
